# ============================================================
# NODE.JS DEPENDENCIES
# ============================================================

# node_modules contains packages installed by npm.
#
# It should not be uploaded to GitHub because:
# - it can be very large
# - it can be recreated using package.json and package-lock.json
# - different operating systems may install slightly different
#   binary files
node_modules/


# ============================================================
# LOG FILES
# ============================================================

# Log files may be generated by Node.js, npm or other tools.
#
# They are temporary diagnostic files and are not part of
# the application source code.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ============================================================
# ENVIRONMENT FILES
# ============================================================

# Environment files may contain machine-specific configuration
# or sensitive values such as administrator credentials.
#
# The application reads configuration from environment variables.
# Local .env files are ignored so credentials or deployment-specific
# paths cannot be committed accidentally.
.env
.env.*

# Keep a documented example environment file if one is created.
!.env.example


# ============================================================
# SQLITE DATABASE
# ============================================================

# SQLite database files are generated locally and contain
# runtime/application data rather than source code.
#
# A fresh database structure can be created using:
#
#     npm run init-db
#
# The initial database can be created and populated from the
# Excel source using:
#
#     npm run setup:initial
database/*.db

# Historical SQLite backups are kept locally but are not part
# of the source repository or final distribution.
backups/


# ============================================================
# EXCEL SOURCE DATA
# ============================================================

# The real theatre inventory workbook is not uploaded to GitHub.
#
# It may contain client data and is treated as an external
# source file rather than application source code.
#
# The importer expects the normal file at:
#
#     data/inventory.xlsx
#
# Any .xlsx file inside data/ is ignored.
data/*.xlsx


# ============================================================
# OPERATING SYSTEM FILES
# ============================================================

# macOS Finder metadata.
.DS_Store

# Windows Explorer metadata.
Thumbs.db
Desktop.ini


# ============================================================
# EDITOR / IDE FILES
# ============================================================

# Visual Studio Code workspace settings are local development
# preferences and are not required to run the project.
.vscode/

# JetBrains IDE project configuration.
.idea/


# ============================================================
# TEMPORARY FILES
# ============================================================

# Temporary backup files sometimes created by editors.
*.tmp
*.temp
*.bak
*~


# ============================================================
# HISTORICAL WORKING DOCUMENTATION
# ============================================================

# Historical DOCX working guides are kept locally for reference.
# Final project documentation will be maintained in Markdown
# inside the version-controlled docs/ directory.
documentation/

# ============================================================
# ELECTRON BUILD OUTPUT
# ============================================================
# Electron build output is generated locally and is not part of
# the source repository.
dist/


# ============================================================
# MKDOCS SITE OUTPUT
# ============================================================
# MkDocs generates a static site from the Markdown documentation
# files in the docs/ directory. The generated site is not part of
# the source repository.
site/